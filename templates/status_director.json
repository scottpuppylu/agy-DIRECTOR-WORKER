{
  "lines": {
    "line-a": {
      "board": "board/STATUS.md",
      "match": "line-a",
      "repo": "../line-a",
      "results": "../line-a/out",
      "glob": "RESULT*.md",
      "log": "../line-a/run.log"
    }
  },
  "schema_version": 1,
  "name": "director",
  "po_pending": {
    "path": "D:/PROJECT/DIRECTOR/PO_PENDING.md",
    "counts": [
      {"label": "pending open", "regex": "^STATUS:\\s*open\\b"},
      {"label": "pending answered", "regex": "^STATUS:\\s*answered\\b"}
    ]
  },
  "orders": {
    "dir": "D:/PROJECT/DIRECTOR/orders",
    "glob": "WO-*.md",
    "show": 8
  },
  "audit": {
    "globs": ["D:/PROJECT/DIRECTOR/research/audit-*.jsonl", "D:/PROJECT/DIRECTOR/audit/*.jsonl"],
    "hours": 1
  },
  "loops": {
    "path": "D:/PROJECT/DIRECTOR/research/loops.json"
  },
  "disk": "D:/",
  "disk_min_gib": 20,
  "max_lines": 60
}
