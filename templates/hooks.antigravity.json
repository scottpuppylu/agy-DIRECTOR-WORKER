{
  "agydw-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|view_file|write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content|grep_search|find_by_name|list_dir|send_message|post_message",
        "hooks": [
          {
            "type": "command",
            "command": "<PYTHON> -B -I -X utf8 <TOOLS>/agy_guard.py --rules <TOOLS>/guard_rules.json --profile worker --mode remind --audit <AUDIT_LOG> --pause-flag <PAUSE_FLAG> --bridge-state <BRIDGE_STATE>",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "agydw-audit-and-bridge": {
    "SessionStart": [
      {
        "type": "command",
        "command": "<PYTHON> -B -I -X utf8 <TOOLS>/agy_hook_bridge.py session-start --resume <RESUME_STATE> --state-dir <BRIDGE_STATE> --banner",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "<PYTHON> -B -I -X utf8 <TOOLS>/agy_audit.py hook-append --log <AUDIT_LOG>",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "<PYTHON> -B -I -X utf8 <TOOLS>/agy_hook_bridge.py post-tool --state-dir <BRIDGE_STATE> --inject-scan",
            "timeout": 15
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "<PYTHON> -B -I -X utf8 <TOOLS>/agy_hook_bridge.py pre-invocation --state-dir <BRIDGE_STATE> --resume <RESUME_STATE>",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "<PYTHON> -B -I -X utf8 <TOOLS>/agy_hook_bridge.py stop-check --resume <RESUME_STATE> --repo <REPO>",
        "timeout": 10
      }
    ]
  }
}
